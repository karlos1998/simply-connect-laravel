{
    "name": "simply-connect/laravel",
    "description": "Official Laravel SDK for the Simply Connect External API",
    "keywords": [
        "laravel",
        "simply-connect",
        "sms",
        "notifications"
    ],
    "homepage": "https://simply-connect.ovh",
    "license": "MIT",
    "authors": [
        {
            "name": "Karol Sojka"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/notifications": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.8",
        "laravel/pint": "^1.26",
        "orchestra/testbench": "^9.17|^10.11|^11.2",
        "phpunit/phpunit": "^11.5|^12.5|^13.0"
    },
    "autoload": {
        "psr-4": {
            "SimplyConnect\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SimplyConnect\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SimplyConnect\\Laravel\\SimplyConnectServiceProvider"
            ],
            "aliases": {
                "SimplyConnect": "SimplyConnect\\Laravel\\Facades\\SimplyConnect"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "format:check": "pint --test",
        "check": [
            "@composer validate --strict",
            "@format:check",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
